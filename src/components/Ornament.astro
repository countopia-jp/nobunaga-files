---
/*
  ページ見出しの意匠｜自作SVG
  ------------------------------------------------
  外部素材なし。図像は幾何と紋の単純化のみで構成する。
  写実的な情景や人物は描かない（当サイトの図版方針）。

  props
    kind : 意匠の種類
      'seal'   … 朱印風の角印（検証・通説系）
      'brush'  … 墨の払い（人物・記録系）
      'mon'    … 木瓜の単純化（権威・政策系）
      'wave'   … 立涌（暮らし・文化系）
      'stone'  … 石積み（土地・建築系）
      'blade'  … 刃文（物・武具系）
*/
const { kind = 'seal' } = Astro.props;
---

<svg class="orn" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  {kind === 'seal' && (
    <g>
      <rect x="6" y="6" width="52" height="52" rx="3" class="o-line" stroke-width="3" />
      <rect x="14" y="14" width="36" height="36" rx="1" class="o-line" stroke-width="1.2" />
      <path d="M22 26h20M22 32h20M22 38h13" class="o-line" stroke-width="2.4" stroke-linecap="round" />
    </g>
  )}

  {kind === 'brush' && (
    <g>
      <path d="M14 10c4 12 6 24 5 34-1 8-3 12-7 16 6-2 10-6 12-12 3-10 2-24-3-38z" class="o-fill" />
      <path d="M26 26c8 6 16 14 22 24 2 4 2 7 0 10-1-6-4-11-9-17-5-6-9-11-13-15z" class="o-fill" />
      <circle cx="46" cy="14" r="4" class="o-fill" />
    </g>
  )}

  {kind === 'mon' && (
    <g class="o-fill">
      <circle cx="32" cy="14" r="10" />
      <circle cx="49" cy="26" r="10" />
      <circle cx="43" cy="46" r="10" />
      <circle cx="21" cy="46" r="10" />
      <circle cx="15" cy="26" r="10" />
      <circle cx="32" cy="32" r="9" />
      <circle cx="32" cy="32" r="4.6" class="o-hole" />
    </g>
  )}

  {kind === 'wave' && (
    <g class="o-line" stroke-width="2.4" fill="none" stroke-linecap="round">
      <path d="M8 20c8-8 16-8 24 0s16 8 24 0" />
      <path d="M8 32c8-8 16-8 24 0s16 8 24 0" />
      <path d="M8 44c8-8 16-8 24 0s16 8 24 0" />
    </g>
  )}

  {kind === 'stone' && (
    <g class="o-line" stroke-width="1.8" fill="none">
      <rect x="8" y="14" width="20" height="11" rx="1.5" />
      <rect x="32" y="14" width="24" height="11" rx="1.5" />
      <rect x="8" y="29" width="26" height="11" rx="1.5" />
      <rect x="38" y="29" width="18" height="11" rx="1.5" />
      <rect x="8" y="44" width="17" height="11" rx="1.5" />
      <rect x="29" y="44" width="27" height="11" rx="1.5" />
    </g>
  )}

  {kind === 'blade' && (
    <g>
      <path d="M8 50C22 40 40 26 56 10c-2 10-8 20-18 28S18 50 8 50z" class="o-fill" />
      <path d="M12 48c14-8 28-20 40-32" class="o-line" stroke-width="1.4" opacity=".5" />
    </g>
  )}
</svg>

<style>
  .orn {
    width: 2.6rem; height: 2.6rem; display: block;
    margin: 0 0 .5rem; opacity: .5; color: var(--shu);
  }
  .o-line { stroke: currentColor; fill: none; }
  .o-fill { fill: currentColor; }
  .o-hole { fill: var(--washi); }
  @media (max-width: 640px) { .orn { width: 2.1rem; height: 2.1rem; } }
</style>
