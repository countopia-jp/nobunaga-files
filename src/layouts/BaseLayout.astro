---
import '../styles/global.css';
import { pages, pageOpen } from '../data/pages.js';

const {
  title = 'ノブナガ・ファイル',
  description = '織田信長をめぐる通説を、時系列で検証する。ドラマで語られる逸話の出典を示し、史料の近さで信憑性度を判定するファイル。',
} = Astro.props;

const sealed = !pageOpen(Astro.url.pathname);

// 封のページは、題と説明も伏せる。中身を出していなくても、
// description や OG に要約が残るとリンクのプレビューで読めてしまう。
const pageTitle = sealed ? 'まだ開いていないページ｜ノブナガ・ファイル' : title;
const pageDesc = sealed
  ? '本文の点検が済んでいないため、いまは閉じています。'
  : description;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/og-image.jpg', Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {sealed && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ノブナガ・ファイル" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a1613" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'ノブナガ・ファイル',
      alternateName: 'The Nobunaga Files',
      url: 'https://nobunaga-files.com',
      description: '織田信長をめぐる通説を、史料の近さで検証する。出典と原文を示し、信憑性度を判定するファイル。',
      inLanguage: 'ja',
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <a href="/" class="brand">
          ノブナガ・ファイル
          <span class="en">THE NOBUNAGA FILES</span>
        </a>
      </div>
    </header>

    <main>
      {sealed ? (
        <div class="wrap sealed-page">
          <p class="sealed-mark" aria-hidden="true">封</p>
          <h1 class="sealed-title">このページはまだ開いていません</h1>
          <p class="sealed-body">
            本文の点検が済んでいないため、いまは閉じています。
            確かめ終わったものから順に開けていきます。
          </p>
          <p class="sealed-back"><a href="/">検証ファイル一覧へ</a></p>
        </div>
      ) : (
        <slot />
      )}
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <nav class="foot-map">
          {pages.map((g) => (
            <div class="fm-group">
              <p class="fm-title">{g.group}</p>
              <div class="fm-links">
                {g.items.map((it) => (
                  pageOpen(it.path)
                    ? <a href={it.path}>{it.label}</a>
                    : <span class="fm-sealed">{it.label}<span class="fm-seal" aria-hidden="true">封</span></span>
                ))}
              </div>
            </div>
          ))}
        </nav>

        <p>
          ノブナガ・ファイル｜通説を鵜呑みにせず、史料の近さで確かめる。
          信憑性度は真偽の断定ではなく、根拠の強さの目安です。
        </p>
        <p class="foot-img">
          図版について：家紋・図表・背景はすべて当サイトの自作。
          史料画像はパブリックドメインのものに限り、所蔵先を明記して掲載しています。
        </p>
        <p class="foot-nav">
          <a href="/policy/">編集方針</a>
          <span class="foot-sep">｜</span>
          <a href="/privacy/">プライバシーポリシー・免責事項</a>
          <span class="foot-sep">｜</span>
          <a href="/contact/">お問い合わせ</a>
        </p>
        <p class="foot-sign">編集：衡一</p>
        <p>&copy; {new Date().getFullYear()} The Nobunaga Files</p>
      </div>
    </footer>
  </body>
</html>
