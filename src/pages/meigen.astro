---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ornament from '../components/Ornament.astro';
import Seal from '../components/Seal.astro';
import { groups, nicknames, around, misattributed, quoteStats } from '../data/quotes.js';
import { getEpisode } from '../data/episodes.js';

const shortTitle = (slug) => {
  const ep = getEpisode(slug);
  if (!ep) return slug;
  return ep.title.split('——')[0].trim();
};

const stats = quoteStats();
---
<BaseLayout
  title="信長の名言・名台詞の真贋 — その言葉は、どこから来たか｜ノブナガ・ファイル"
  description="「是非に及ばず」「敵は本能寺にあり」「鳴かぬなら」「人間五十年」「であるか」。織田信長の言葉として広まっているものを、出典の近さで分類し、信憑性度を添えて検証する。"
>
  <article class="wrap meigen">
   <Ornament kind="seal" />
     <p class="ep-back"><a href="/">← 一覧へ戻る</a></p>

    <p class="eyebrow">名言・名台詞</p>
    <h1 class="mg-title">その言葉は、どこから来たか</h1>
    <p class="mg-lead">
      信長の言葉として引かれるもののうち、記録に残っているものは驚くほど少ない。
      有名さと、出典の近さは比例しない。
      むしろ<strong>最も有名な台詞ほど、最も遠い本から来ている</strong>。
      全 {stats.total} 句のうち、史料にあると言えるのは {stats.documented} 句だけである。
    </p>

    {groups.map((g) => (
      <section class="mg-sec">
        <h2 class="mg-sec-title">{g.title}</h2>
        <p class="mg-sec-lead">{g.lead}</p>

        {g.quotes.map((q) => (
          <div class="qt">
            <div class="qt-head">
              <div class="qt-headtext">
                <p class="qt-text">{q.text}</p>
                <p class="qt-verdict">{q.verdict}</p>
              </div>
              <div class="qt-seal"><Seal rating={q.rating} size="sm" /></div>
            </div>

            <p class="qt-origin">
              <span class="qt-kind">{q.kind}</span>
              <span class="qt-origin-label">出どころ</span>
              <span class="qt-origin-name">{q.origin}</span>
            </p>

            <p class="qt-desc">{q.desc}</p>
            {q.caution && (
              <p class="qt-caution"><span class="qt-c-label">注意</span>{q.caution}</p>
            )}
            {q.episodes && q.episodes.length > 0 && (
              <p class="qt-eps">
                {q.episodes.map((slug) => (
                  <a href={`/episodes/${slug}/`}>{shortTitle(slug)} →</a>
                ))}
              </p>
            )}
          </div>
        ))}
      </section>
    ))}

    <section class="mg-sec">
      <h2 class="mg-sec-title">{nicknames.title}</h2>
      <p class="mg-sec-lead">{nicknames.lead}</p>
      {nicknames.items.map((n) => (
        <div class="nk">
          <div class="nk-head">
            <p class="nk-word">{n.word}</p>
            <span class="nk-who">{n.who}</span>
            <div class="nk-seal"><Seal rating={n.rating} size="sm" /></div>
          </div>
          <p class="nk-verdict">{n.verdict}</p>
          <p class="nk-desc">{n.desc}</p>
          {n.sources && (
            <ul class="q-sources">
              {n.sources.map((s) => (
                <li>
                  <span class="qs-label">{s.label}</span>
                  <span class="qs-kind">{s.kind}</span>
                  <span class="qs-note">{s.note}</span>
                </li>
              ))}
            </ul>
          )}
          {n.genbun && (
            <div class="nk-genbun">
              <p class="nkg-text">{n.genbun.text}</p>
              <p class="nkg-cite">{n.genbun.cite}</p>
              <p class="nkg-note">{n.genbun.note}</p>
            </div>
          )}
          {n.link && <p class="nk-link"><a href={n.link.href}>{n.link.label} →</a></p>}
        </div>
      ))}
      <p class="nk-note">{nicknames.note}</p>
    </section>

    <section class="mg-sec">
      <h2 class="mg-sec-title">{around.title}</h2>
      <p class="mg-sec-lead">{around.lead}</p>
      {around.items.map((a) => (
        <div class="ar">
          <div class="ar-head">
            <p class="ar-text">{a.text}</p>
            <span class="ar-who">{a.who}</span>
            <div class="ar-seal"><Seal rating={a.rating} size="sm" /></div>
          </div>
          <p class="ar-verdict">{a.verdict}</p>
          <p class="ar-desc">{a.desc}</p>
          {a.sources && (
            <ul class="q-sources">
              {a.sources.map((s) => (
                <li>
                  <span class="qs-label">{s.label}</span>
                  <span class="qs-kind">{s.kind}</span>
                  <span class="qs-note">{s.note}</span>
                </li>
              ))}
            </ul>
          )}
          <p class="ar-caution"><span class="ar-caution-label">注意</span>{a.caution}</p>
        </div>
      ))}
    </section>

    <section class="mg-sec">
      <h2 class="mg-sec-title">そもそも信長の言葉ではないもの</h2>
      <p class="mg-sec-lead">別人の言葉が、いつのまにか信長に付け替えられている例。</p>
      <ul class="mis-list">
        {misattributed.map((m) => (
          <li class="mis">
            <p class="mis-text">{m.text}</p>
            <p class="mis-who">本来は：{m.who}</p>
            <p class="mis-note">{m.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <p class="mg-foot">
      言葉は、人物像を最短距離で伝える。だからこそ、後世が最も手を入れたがる部分でもある。
      「是非に及ばず」は牛一が書き留めた六文字だが、
      「敵は本能寺にあり」は頼山陽の筆であり、「であるか」に至っては誰が言わせたのかも分からない。
      信長の言葉を引くとき、私たちはしばしば
      <strong>信長ではなく、後の時代の誰かの文章</strong>を引いている。
    </p>

    <p class="mg-related">
      関連：<a href="/shiryo/">文献一覧</a>
      <span class="mg-sep">｜</span>
      <a href="/kuromaku/">本能寺の黒幕説</a>
    </p>

    <p class="ep-back ep-back-btm"><a href="/">← 一覧へ戻る</a></p>
  </article>
</BaseLayout>

<style>
  .meigen { max-width: 52rem; padding-block: 2rem 3rem; }
  .ep-back { margin: 0 0 1rem; }
  .ep-back a { font-size: .84rem; color: var(--sumi-soft); }
  .ep-back-btm { margin-top: 2.4rem; }

  .mg-title { font-size: clamp(1.7rem, 5vw, 2.4rem); margin: .2rem 0 1rem; }
  .mg-lead { color: var(--sumi-soft); line-height: 1.9; margin: 0 0 2.4rem; }
  .mg-lead strong { color: var(--shu); }

  .mg-sec { margin-bottom: 2.8rem; }
  .mg-sec-title {
    font-size: 1.25rem; margin: 0 0 .5rem; padding-bottom: .4rem;
    border-bottom: 2px solid var(--sumi); line-height: 1.5;
  }
  .mg-sec-lead {
    margin: 0 0 1.2rem; font-size: .86rem; color: var(--sumi-soft); line-height: 1.8;
  }

  .qt {
    border: 1px solid var(--rule); border-left: 3px solid var(--shu);
    background: var(--washi); padding: 1rem 1.2rem; margin-bottom: 1rem;
  }
  .qt-head { display: flex; align-items: flex-start; gap: 1rem; }
  .qt-headtext { flex: 1; min-width: 0; }
  .qt-text {
    margin: 0; font-family: var(--font-mincho); font-size: 1.4rem;
    font-weight: 700; color: var(--sumi); line-height: 1.5; letter-spacing: .04em;
  }
  .qt-verdict {
    margin: .25rem 0 0; font-size: .8rem; color: var(--shu);
    font-family: var(--font-mincho);
  }
  .qt-seal { flex-shrink: 0; }

  .qt-origin {
    margin: .8rem 0 .6rem; padding: .4rem .7rem;
    background: var(--washi-deep);
    display: flex; align-items: baseline; gap: .6rem; flex-wrap: wrap;
    font-size: .82rem;
  }
  .qt-kind {
    font-family: var(--font-mincho); font-size: .68rem; flex-shrink: 0;
    border: 1px solid var(--rule); background: var(--washi);
    padding: .05em .5em; border-radius: 2px;
  }
  .qt-origin-label { font-size: .72rem; color: var(--sumi-soft); }
  .qt-origin-name { font-family: var(--font-mincho); color: var(--sumi); }

  .qt-desc { margin: 0; font-size: .9rem; line-height: 1.85; }
  .qt-caution {
    margin: .55rem 0 0; font-size: .8rem; line-height: 1.78; color: var(--sumi-soft);
    padding-left: .8rem; border-left: 2px solid var(--rule);
  }
  .qt-c-label {
    font-family: var(--font-mincho); color: var(--shu);
    margin-right: .6em; font-size: .77rem;
  }
  .qt-eps { margin: .5rem 0 0; font-size: .78rem; }
  .qt-eps a { margin-right: .7em; }

  .nk {
    border: 1px solid var(--rule); border-left: 3px solid var(--shu);
    background: var(--washi); padding: .85rem 1.1rem; margin-bottom: .8rem;
  }
  .nk-head { display: flex; align-items: center; gap: .7rem; flex-wrap: wrap; }
  .nk-word {
    margin: 0; font-family: var(--font-mincho); font-size: 1.25rem;
    font-weight: 700; color: var(--sumi); letter-spacing: .04em;
  }
  .nk-who {
    font-size: .74rem; color: var(--sumi-soft); font-family: var(--font-gothic);
    border: 1px solid var(--rule); background: var(--washi-deep);
    padding: .1em .55em; border-radius: 2px;
  }
  .nk-seal { margin-left: auto; }
  .nk-verdict { margin: .3rem 0 0; font-size: .78rem; color: var(--shu); font-family: var(--font-mincho); }
  .nk-desc { margin: .35rem 0 0; font-size: .88rem; line-height: 1.8; }
  .nk-link { margin: .35rem 0 0; font-size: .78rem; }
  .nk-genbun {
    margin: .7rem 0 0; padding: .55rem 0 .55rem .85rem;
    border-left: 3px solid var(--shu); background: var(--washi-deep);
  }
  .nkg-text {
    margin: 0; font-family: var(--font-mincho); font-size: .95rem;
    line-height: 1.95; letter-spacing: .02em;
  }
  .nkg-cite { margin: .3rem 0 0; font-size: .74rem; color: var(--sumi-soft); }
  .nkg-note { margin: .4rem 0 0; font-size: .8rem; line-height: 1.8; color: var(--sumi-soft); }
  .q-sources {
    list-style: none; margin: .7rem 0 0; padding: .6rem .85rem;
    background: var(--washi-deep); border-left: 2px solid #b8912f;
  }
  .q-sources li {
    padding: .3rem 0; border-bottom: 1px dotted var(--rule);
    font-size: .82rem; line-height: 1.8;
  }
  .q-sources li:last-child { border-bottom: none; }
  .qs-label { font-family: var(--font-mincho); font-weight: 700; margin-right: .6em; }
  .qs-kind {
    font-size: .68rem; color: var(--sumi-soft); border: 1px solid var(--rule);
    background: var(--washi); padding: .05em .45em; border-radius: 2px; margin-right: .6em;
  }
  .qs-note { color: var(--sumi-soft); }

  .nk-note {
    margin: 1rem 0 0; padding: .6rem .9rem;
    background: var(--washi-deep); font-size: .84rem; line-height: 1.85; color: var(--sumi-soft);
  }

  .ar {
    border: 1px solid var(--rule); border-left: 3px solid var(--shu);
    background: var(--washi); padding: .9rem 1.1rem; margin-bottom: .9rem;
  }
  .ar-head { display: flex; align-items: center; gap: .7rem; flex-wrap: wrap; }
  .ar-text {
    margin: 0; font-family: var(--font-mincho); font-size: 1.2rem;
    font-weight: 700; color: var(--sumi); letter-spacing: .04em;
  }
  .ar-who {
    font-size: .74rem; color: var(--sumi-soft); font-family: var(--font-gothic);
    border: 1px solid var(--rule); background: var(--washi-deep);
    padding: .1em .55em; border-radius: 2px;
  }
  .ar-seal { margin-left: auto; }
  .ar-verdict { margin: .3rem 0 0; font-size: .78rem; color: var(--shu); font-family: var(--font-mincho); }
  .ar-desc { margin: .4rem 0 0; font-size: .88rem; line-height: 1.88; }
  .ar-caution {
    margin: .6rem 0 0; padding: .5rem .8rem; background: var(--washi-deep);
    font-size: .83rem; line-height: 1.82; color: var(--sumi-soft);
  }
  .ar-caution-label {
    font-family: var(--font-mincho); color: var(--shu); margin-right: .65em; font-size: .78rem;
  }

  .mis-list { list-style: none; margin: 0; padding: 0; }
  .mis {
    border: 1px solid var(--rule); background: var(--washi);
    padding: .8rem 1rem; margin-bottom: .8rem;
  }
  .mis-text {
    margin: 0; font-family: var(--font-mincho); font-size: 1.05rem;
    color: var(--sumi); line-height: 1.5;
  }
  .mis-who {
    margin: .2rem 0 .4rem; font-size: .78rem; color: var(--shu);
    font-family: var(--font-gothic);
  }
  .mis-note { margin: 0; font-size: .84rem; line-height: 1.8; color: var(--sumi-soft); }

  .mg-foot {
    margin: 2.4rem 0 0; padding-top: 1.2rem; border-top: 3px double var(--sumi);
    font-size: .9rem; color: var(--sumi-soft); line-height: 1.95;
  }
  .mg-foot strong { color: var(--shu); }
  .mg-related { margin: 1.2rem 0 0; font-size: .84rem; }
  .mg-sep { color: var(--rule); margin: 0 .5em; }

  @media (max-width: 640px) {
    .qt-head { flex-direction: column; gap: .6rem; }
    .qt-text { font-size: 1.2rem; }
  }
</style>
