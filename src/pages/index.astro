---
import BaseLayout from '../layouts/BaseLayout.astro';
import Seal from '../components/Seal.astro';
import { episodesByYear, timelessEpisodes, ratingRange } from '../data/episodes.js';

const list = episodesByYear();
const portraits = timelessEpisodes();
---

<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">織田信長 検証ファイル</p>
      <h1 class="hero-title">通説を、鵜呑みにしない。</h1>
      <p class="hero-lead">
        ドラマや小説で語られる信長の逸話を、年代順にならべる。
        それぞれの出典を示し、史料の近さで<strong>信憑性度</strong>を判定する。
        真偽を断じるのではなく、根拠の強さを見えるようにするためのファイル。
      </p>
    </div>
  </section>

  <section class="wrap">
    <ol class="timeline">
      {list.map((ep) => {
        const { min, max } = ratingRange(ep);
        return (
          <li class="tl-item">
            <div class="tl-year">
              <span class="tl-year-num">{ep.year}</span>
              <span class="tl-year-wa">{ep.dateLabel}</span>
            </div>
            <a class="tl-card" href={`/episodes/${ep.slug}/`}>
              <div class="tl-card-body">
                <h2 class="tl-card-title">{ep.title}</h2>
                <p class="tl-card-lead">{ep.lead}</p>
                <p class="tl-card-tags">
                  {ep.tags.map((t) => <span class="tag">{t}</span>)}
                  <span class="tl-count">検証項目 {ep.points.length}件</span>
                </p>
              </div>
              <div class="tl-card-seal">
                <Seal rating={max} size="sm" />
                {min !== max && <span class="tl-spread">信憑 {min}〜{max}</span>}
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  {portraits.length > 0 && (
    <section class="wrap portraits">
      <div class="portraits-head">
        <p class="eyebrow">時系列の外</p>
        <h2 class="portraits-title">人物像ファイル</h2>
        <p class="portraits-lead">特定の年に起きた出来事ではなく、後世に作られた「信長像」を検証する。</p>
      </div>
      <ul class="portrait-grid">
        {portraits.map((ep) => {
          const { min, max } = ratingRange(ep);
          return (
            <li>
              <a class="tl-card" href={`/episodes/${ep.slug}/`}>
                <div class="tl-card-body">
                  <h3 class="tl-card-title">{ep.title}</h3>
                  <p class="tl-card-lead">{ep.lead}</p>
                  <p class="tl-card-tags">
                    {ep.tags.map((t) => <span class="tag">{t}</span>)}
                    <span class="tl-count">検証項目 {ep.points.length}件</span>
                  </p>
                </div>
                <div class="tl-card-seal">
                  <Seal rating={max} size="sm" />
                  {min !== max && <span class="tl-spread">信憑 {min}〜{max}</span>}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .hero { border-bottom: 1px solid var(--rule); }
  .hero .wrap { padding-block: 3.2rem 2.4rem; }
  .hero-title {
    font-size: clamp(2rem, 6vw, 3.1rem);
    margin: 0 0 1rem; letter-spacing: .04em;
  }
  .hero-lead { max-width: 40rem; margin: 0; color: var(--sumi-soft); }
  .hero-lead strong { color: var(--shu); }

  .timeline { list-style: none; margin: 2.4rem 0; padding: 0; position: relative; }
  /* 時系列を貫く1本の墨線 */
  .timeline::before {
    content: ''; position: absolute; left: 6.5rem; top: .5rem; bottom: .5rem;
    width: 2px; background: var(--rule);
  }
  .tl-item {
    position: relative; display: grid;
    grid-template-columns: 6.5rem 1fr; gap: 1.4rem;
    padding-block: 1.1rem;
  }
  .tl-year { text-align: right; padding-top: .2rem; }
  .tl-year-num {
    display: block; font-family: var(--font-mincho);
    font-size: 1.3rem; font-weight: 700; color: var(--sumi);
  }
  .tl-year-wa { display: block; font-size: .66rem; color: var(--sumi-soft); }
  /* 線上の節点 */
  .tl-item::before {
    content: ''; position: absolute; left: calc(6.5rem - 4px); top: 1.5rem;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--washi); border: 2px solid var(--shu);
  }

  .tl-card {
    display: flex; gap: 1rem; align-items: flex-start; justify-content: space-between;
    background: var(--washi); border: 1px solid var(--rule);
    border-left: 3px solid var(--sumi);
    padding: 1.1rem 1.2rem; color: inherit;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .tl-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,.08); text-decoration: none; }
  .tl-card-title { font-size: 1.16rem; margin: 0 0 .5rem; color: var(--sumi); }
  .tl-card-lead {
    margin: 0 0 .7rem; font-size: .9rem; color: var(--sumi-soft);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .tl-card-tags { margin: 0; display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
  .tag {
    font-size: .68rem; color: var(--sumi-soft);
    border: 1px solid var(--rule); border-radius: 2px; padding: .05em .5em;
  }
  .tl-count { font-size: .7rem; color: var(--shu); margin-left: auto; }

  .tl-card-seal { display: flex; flex-direction: column; align-items: center; gap: .3rem; flex-shrink: 0; }
  .tl-spread { font-size: .62rem; color: var(--sumi-soft); font-family: var(--font-mincho); }

  .portraits { margin-top: 1rem; padding-top: 2rem; border-top: 3px double var(--sumi); }
  .portraits-head { margin-bottom: 1.4rem; }
  .portraits-title { font-size: 1.5rem; margin: 0 0 .4rem; }
  .portraits-lead { margin: 0; color: var(--sumi-soft); font-size: .9rem; }
  .portrait-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .portrait-grid .tl-card { border-left-color: var(--shu); }

  @media (max-width: 620px) {
    .timeline::before { left: 4.4rem; }
    .tl-item { grid-template-columns: 4.4rem 1fr; gap: .8rem; }
    .tl-item::before { left: calc(4.4rem - 4px); }
    .tl-year-num { font-size: 1.05rem; }
    .tl-card { flex-direction: column-reverse; }
    .tl-card-seal { flex-direction: row; align-self: flex-end; }
  }
</style>
