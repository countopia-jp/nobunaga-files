---
import BaseLayout from '../layouts/BaseLayout.astro';
import { hrefOpen } from '../data/episodes.js';
import Ornament from '../components/Ornament.astro';
import Seal from '../components/Seal.astro';
import { lead, cases, claims, closing } from '../data/mono.js';
---
<BaseLayout
  title="物から検証する — 記録を介さずに分かること｜ノブナガ・ファイル"
  description="鉄砲玉の鉛はどこの鉱山から来たか。本能寺はどんな構造だったか。比叡山はどこまで焼けたか。鉛同位体比分析と発掘調査という、文字の記録とは別系統の証拠から検証する。"
>
  <article class="wrap mono">
   <Ornament kind="blade" />
     <p class="ep-back"><a href="/">← 一覧へ戻る</a></p>

    <p class="eyebrow">方法の検証</p>
    <h1 class="ys-title">記録を介さずに、分かること</h1>
    <p class="ys-lead">
      当サイトの判定は、原則として「その話がどの種類の記録に載っているか」で決まる。
      だが<strong>記録を介さずに確かめられることがある。</strong>
      発掘された遺構、出土した金属の成分、火を受けた瓦の変色。
      誰かが書き残したものではなく、そのとき物理的に起きたことの痕跡である。
    </p>

    <section class="ys-sec">
      {lead.map((p) => <p class="ys-para">{p}</p>)}
    </section>

    

    {cases.map((i) => (
      <section class="is">
        <div class="is-head">
          <span class="is-n">{i.method}</span>
          <h2 class="is-title">{i.title}</h2>
        </div>
        <p class="is-lead">{i.lead}</p>
        {i.body.map((p) => <p class="is-para">{p}</p>)}
        {i.caution && <p class="is-note"><span class="is-note-label">限界</span>{i.caution}</p>}
        {i.link && hrefOpen(i.link.href) && <p class="is-link"><a href={i.link.href}>{i.link.label} →</a></p>}
      </section>
    ))}

    <section class="ys-sec">
      <h2 class="ys-sec-title">検証</h2>
      {claims.map((c) => (
        <div class="claim">
          <div class="claim-head">
            <div class="claim-headtext">
              <h3 class="claim-title">{c.claim}</h3>
              <p class="claim-verdict">{c.verdict}</p>
            </div>
            <div class="claim-seal"><Seal rating={c.rating} size="sm" /></div>
          </div>
          <p class="claim-desc">{c.desc}</p>
          {c.sources && (
            <ul class="claim-sources">
              {c.sources.map((s) => (
                <li>
                  <span class="cs-label">{s.label}</span>
                  <span class="cs-kind">{s.kind}</span>
                  <span class="cs-note">{s.note}</span>
                  {s.quote && (
                    <blockquote class="cs-genbun">
                      <p class="cs-genbun-text">{s.quote}</p>
                      {s.cite && <cite>—{s.cite}</cite>}
                    </blockquote>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </section>

    <section class="ys-closing">
      <h2 class="ys-sec-title">得意な問いが、違う</h2>
      {closing.map((p) => <p class="ys-para">{p}</p>)}
    </section>

    <p class="ys-related">
      関連：<a href="/shiryo/">文献一覧（史料の同心円図）</a>
      <span class="ys-sep">｜</span><a href="/shiseki/">史跡・資料館</a>
      <span class="ys-sep">｜</span><a href="/token/">信長の刀</a>
    </p>

    <p class="ep-back ep-back-btm"><a href="/">← 一覧へ戻る</a></p>
  </article>
</BaseLayout>

<style>
  .yasuke { max-width: 50rem; padding-block: 2rem 3rem; }
  .ep-back { margin: 0 0 1rem; }
  .ep-back a { font-size: .84rem; color: var(--sumi-soft); }
  .ep-back-btm { margin-top: 2.4rem; }

  .ys-title { font-size: clamp(1.65rem, 4.8vw, 2.3rem); margin: .2rem 0 1rem; line-height: 1.45; }
  .ys-lead { color: var(--sumi-soft); line-height: 1.95; margin: 0 0 2.4rem; }
  .ys-lead strong { color: var(--shu); }

  .ys-sec { margin-bottom: 2.8rem; }
  .ys-sec-title {
    font-size: 1.25rem; margin: 0 0 .9rem; padding-bottom: .4rem;
    border-bottom: 2px solid var(--sumi); line-height: 1.5;
  }
  .ys-para { margin: 0 0 1.1rem; font-size: .92rem; line-height: 2; }

  .rc {
    border: 1px solid var(--rule); background: var(--washi);
    padding: .85rem 1.05rem; margin-bottom: .85rem;
  }
  .rc--key { border-left: 3px solid var(--shu); background: #fbf3ef; }
  .rc-head { display: flex; align-items: baseline; gap: .7rem; flex-wrap: wrap; }
  .rc-src { font-size: 1.02rem; margin: 0; line-height: 1.5; font-family: var(--font-mincho); }
  .rc-kind {
    font-family: var(--font-mincho); font-size: .68rem; color: var(--sumi-soft);
    border: 1px solid var(--rule); background: var(--washi-deep);
    padding: .1em .5em; border-radius: 2px;
  }
  .rc-d { margin: .35rem 0 0; font-size: .88rem; line-height: 1.88; color: var(--sumi-soft); }

  .is {
    border: 1px solid var(--rule); border-left: 3px solid var(--shu);
    background: var(--washi); padding: 1.1rem 1.2rem; margin-bottom: 1.4rem;
  }
  .is-head { display: flex; align-items: baseline; gap: .8rem; flex-wrap: wrap; margin-bottom: .6rem; }
  .is-n {
    font-family: var(--font-mincho); font-size: .74rem; color: var(--washi);
    background: var(--shu); padding: .15em .7em; border-radius: 2px; white-space: nowrap;
  }
  .is-title { font-size: 1.18rem; margin: 0; line-height: 1.5; }
  .is-lead { margin: 0 0 .8rem; font-size: .93rem; line-height: 1.9; }
  .is-para { margin: 0 0 .9rem; font-size: .89rem; line-height: 1.92; color: var(--sumi-soft); }
  .is-para:last-of-type { margin-bottom: 0; }
  .is-link { margin: .6rem 0 0; font-size: .8rem; }
  .is-note {
    margin: .9rem 0 0; padding: .55rem .8rem; background: var(--washi-deep);
    font-size: .82rem; line-height: 1.82; color: var(--sumi-soft);
  }
  .is-note-label {
    font-family: var(--font-mincho); color: var(--shu); margin-right: .6em; font-size: .78rem;
  }

  .claim {
    border: 1px solid var(--rule); border-left: 3px solid var(--shu);
    background: var(--washi); padding: 1rem 1.1rem; margin-bottom: 1rem;
  }
  .claim-head { display: flex; align-items: flex-start; gap: 1rem; }
  .claim-headtext { flex: 1; min-width: 0; }
  .claim-title { font-size: 1.02rem; margin: 0; line-height: 1.55; }
  .claim-verdict { margin: .2rem 0 0; font-size: .78rem; color: var(--shu); font-family: var(--font-mincho); }
  .claim-seal { flex-shrink: 0; }
  .claim-desc { margin: .7rem 0 0; font-size: .89rem; line-height: 1.85; }

  .ys-closing { margin-top: 3rem; padding-top: 1.4rem; border-top: 3px double var(--sumi); }
  .ys-closing .ys-sec-title { border-bottom-color: var(--shu); }

  .ys-related { margin: 2rem 0 0; font-size: .84rem; }
  .ys-sep { color: var(--rule); margin: 0 .5em; }

  @media (max-width: 640px) {
    .claim-head { flex-direction: column; gap: .6rem; }
  }
  .claim-sources {
    list-style: none; margin: .7rem 0 0; padding: .6rem .85rem;
    background: var(--washi-deep); border-left: 2px solid #b8912f;
  }
  .claim-sources li {
    padding: .3rem 0; border-bottom: 1px dotted var(--rule);
    font-size: .82rem; line-height: 1.8;
  }
  .claim-sources li:last-child { border-bottom: none; }
  .cs-label { font-family: var(--font-mincho); font-weight: 700; margin-right: .6em; }
  .cs-kind {
    font-size: .68rem; color: var(--sumi-soft); border: 1px solid var(--rule);
    background: var(--washi); padding: .05em .45em; border-radius: 2px; margin-right: .6em;
  }
  .cs-note { color: var(--sumi-soft); }
  .cs-genbun {
    margin: .5rem 0 .2rem; padding: .6rem .85rem;
    border-left: 2px solid var(--shu); background: #faf7f0;
  }
  .cs-genbun-text {
    margin: 0; font-family: var(--font-mincho); font-size: .93rem;
    line-height: 2.05; letter-spacing: .03em; color: var(--sumi);
  }
  .cs-genbun cite {
    display: block; margin-top: .4rem; font-size: .74rem;
    color: var(--sumi-soft); font-style: normal; line-height: 1.7;
  }
</style>
