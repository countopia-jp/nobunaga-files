---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ornament from '../components/Ornament.astro';
import Seal from '../components/Seal.astro';
import { overview, women, claims, closing } from '../data/tsuma.js';
---
<BaseLayout
  title="妻と子 — 母のわからない子が多い｜ノブナガ・ファイル"
  description="信長の子は二十人を超えるとされるが、生母がはっきり分かる子はごく少ない。濃姫、生駒吉乃、お鍋の方。女性の記録がどういうときに残るのかを、史料の側から考える。"
>
  <article class="wrap tsuma">
   <Ornament kind="brush" />
     <p class="ep-back"><a href="/">← 一覧へ戻る</a></p>

    <p class="eyebrow">人物の検証</p>
    <h1 class="tk-title">母のわからない子が、多い</h1>
    <p class="tk-lead">
      信長の子は、合わせて二十人を超えるという数え方も行われる。
      ところが<strong>その母が誰かとなると、はっきりしない子のほうが多い。</strong>
      記録が乏しいのは正室に限らない。側室たちの記録も、そのほとんどが断片である。
    </p>

    <section class="tk-sec">
      {overview.map((p) => <p class="tk-para">{p}</p>)}
    </section>

    <section class="tk-sec">
      {women.map((s) => (
        <div class="sw">
          <div class="sw-head">
            <div class="sw-headtext">
              <h2 class="sw-name">{s.name}</h2>
              <span class="sw-alias">{s.role}</span>
            </div>
            <div class="sw-seal"><Seal rating={s.rating} size="sm" /></div>
          </div>
          <p class="sw-story">{s.d}</p>
          <p class="sw-key">{s.key}</p>
          {s.link && <p class="sw-link"><a href={s.link.href}>{s.link.label} →</a></p>}
        </div>
      ))}
    </section>

    <section class="tk-sec">
      <h2 class="tk-sec-title">検証</h2>
      {claims.map((c) => (
        <div class="claim">
          <div class="claim-head">
            <div class="claim-headtext">
              <h3 class="claim-title">{c.claim}</h3>
              <p class="claim-verdict">{c.verdict}</p>
            </div>
            <div class="claim-seal"><Seal rating={c.rating} size="sm" /></div>
          </div>
          <p class="claim-desc">{c.desc}</p>
          {c.sources && (
            <ul class="claim-sources">
              {c.sources.map((s) => (
                <li>
                  <span class="cs-label">{s.label}</span>
                  <span class="cs-kind">{s.kind}</span>
                  <span class="cs-note">{s.note}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </section>

    <section class="tk-closing">
      <h2 class="tk-sec-title">記録が残る条件</h2>
      {closing.map((p) => <p class="tk-para">{p}</p>)}
    </section>

    <p class="tk-related">
      関連：<a href="/meibutsu/">名物茶器</a>
      <span class="tk-sep">｜</span><a href="/ranjatai/">蘭奢待</a>
      <span class="tk-sep">｜</span><a href="/shiseki/">史跡・資料館</a>
      <span class="tk-sep">｜</span><a href="/episodes/tenka-fubu/">天下布武</a>
    </p>

    <p class="ep-back ep-back-btm"><a href="/">← 一覧へ戻る</a></p>
  </article>
</BaseLayout>

<style>
  .token { max-width: 50rem; padding-block: 2rem 3rem; }
  .ep-back { margin: 0 0 1rem; }
  .ep-back a { font-size: .84rem; color: var(--sumi-soft); }
  .ep-back-btm { margin-top: 2.4rem; }

  .tk-title { font-size: clamp(1.7rem, 5vw, 2.4rem); margin: .2rem 0 1rem; line-height: 1.45; }
  .tk-lead { color: var(--sumi-soft); line-height: 1.95; margin: 0 0 2.4rem; }
  .tk-lead strong { color: var(--shu); }

  .tk-sec { margin-bottom: 2.8rem; }
  .tk-sec-title {
    font-size: 1.25rem; margin: 0 0 .9rem; padding-bottom: .4rem;
    border-bottom: 2px solid var(--sumi); line-height: 1.5;
  }
  .tk-para { margin: 0 0 1.1rem; font-size: .92rem; line-height: 2; }

  .sw {
    border: 1px solid var(--rule); border-left: 3px solid var(--shu);
    background: var(--washi); padding: 1.1rem 1.2rem; margin-bottom: 1.2rem;
  }
  .sw-head { display: flex; align-items: flex-start; gap: 1rem; }
  .sw-headtext { flex: 1; min-width: 0; }
  .sw-name {
    font-size: 1.3rem; margin: 0; line-height: 1.4; letter-spacing: .05em;
  }
  .sw-alias { font-size: .76rem; color: var(--sumi-soft); font-family: var(--font-gothic); }
  .sw-seal { flex-shrink: 0; }
  .sw-now {
    margin: .5rem 0 0; padding: .4rem .7rem; background: var(--washi-deep);
    font-size: .82rem; color: var(--sumi-soft);
  }
  .sw-now-label {
    font-family: var(--font-mincho); color: var(--shu); margin-right: .7em; font-size: .78rem;
  }
  .sw-verdict { margin: .35rem 0 0; font-size: .78rem; color: var(--shu); font-family: var(--font-mincho); }
  .sw-story { margin: .6rem 0 0; font-size: .89rem; line-height: 1.92; color: var(--sumi-soft); }
  .sw-key {
    margin: .8rem 0 0; padding: .65rem .9rem; background: #fbf3ef;
    border-left: 2px solid var(--shu); font-size: .88rem; line-height: 1.9;
  }
  .sw-link { margin: .5rem 0 0; font-size: .8rem; }
  .sw-caution {
    margin: .6rem 0 0; padding: .5rem .8rem; background: var(--washi-deep);
    font-size: .83rem; line-height: 1.82; color: var(--sumi-soft);
  }
  .sw-caution-label {
    font-family: var(--font-mincho); color: var(--shu); margin-right: .65em; font-size: .78rem;
  }

  .claim {
    border: 1px solid var(--rule); border-left: 3px solid var(--shu);
    background: var(--washi); padding: 1rem 1.1rem; margin-bottom: 1rem;
  }
  .claim-head { display: flex; align-items: flex-start; gap: 1rem; }
  .claim-headtext { flex: 1; min-width: 0; }
  .claim-title { font-size: 1.02rem; margin: 0; line-height: 1.55; }
  .claim-verdict { margin: .2rem 0 0; font-size: .78rem; color: var(--shu); font-family: var(--font-mincho); }
  .claim-seal { flex-shrink: 0; }
  .claim-desc { margin: .7rem 0 0; font-size: .89rem; line-height: 1.85; }

  .tk-closing { margin-top: 3rem; padding-top: 1.4rem; border-top: 3px double var(--sumi); }
  .tk-closing .tk-sec-title { border-bottom-color: var(--shu); }

  .tk-related { margin: 2rem 0 0; font-size: .84rem; }
  .tk-sep { color: var(--rule); margin: 0 .5em; }

  @media (max-width: 640px) {
    .sw-head, .claim-head { flex-direction: column; gap: .5rem; }
  }
  .claim-sources {
    list-style: none; margin: .7rem 0 0; padding: .6rem .85rem;
    background: var(--washi-deep); border-left: 2px solid #b8912f;
  }
  .claim-sources li {
    padding: .3rem 0; border-bottom: 1px dotted var(--rule);
    font-size: .82rem; line-height: 1.8;
  }
  .claim-sources li:last-child { border-bottom: none; }
  .cs-label { font-family: var(--font-mincho); font-weight: 700; margin-right: .6em; }
  .cs-kind {
    font-size: .68rem; color: var(--sumi-soft); border: 1px solid var(--rule);
    background: var(--washi); padding: .05em .45em; border-radius: 2px; margin-right: .6em;
  }
  .cs-note { color: var(--sumi-soft); }
</style>
