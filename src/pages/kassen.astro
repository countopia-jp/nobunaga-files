---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ornament from '../components/Ornament.astro';
import { battles, battleStats, RESULT } from '../data/battles.js';
import { getEpisode } from '../data/episodes.js';

const shortTitle = (slug) => {
  const ep = getEpisode(slug);
  if (!ep) return slug;
  return ep.title.split('——')[0].trim();
};

const stats = battleStats();
const results = Object.keys(RESULT);

// 首巻＝上洛以前、本記＝上洛以後で二つに割る
const early = battles.filter((b) => b.maki === '首巻');
const late = battles.filter((b) => b.maki !== '首巻');
---
<BaseLayout
  title="織田信長 合戦データベース — 生涯の主要な戦い｜ノブナガ・ファイル"
  description="織田信長が関わった主な合戦を年代順に一覧する。相手・場所・結果・『信長公記』の該当巻・信長自身の出陣の有無をまとめ、兵力は出典を示せるものだけを載せる。後世の軍記が加えた脚色も併記。"
>
  <article class="wrap kassen">
   <Ornament kind="stone" />
     <p class="ep-back"><a href="/">← 一覧へ戻る</a></p>

    <p class="eyebrow">合戦データベース</p>
    <h1 class="ks-title">生涯の戦い、{stats.total}件</h1>
    <p class="ks-lead">
      信長が関わった主な合戦を年代順に並べる。
      それぞれ<strong>『信長公記』のどの巻に載るか</strong>を添えたので、
      気になった戦は原文にあたれる。
      勝った戦だけでなく、負けた戦、撤退した戦も同じ重みで並べてある。
    </p>

    <div class="ks-legend">
      <p class="ks-legend-row">
        {results.map((r) => (
          <span class={`rs rs-${RESULT[r].rank}`}>{r} {stats.by[r] ?? 0}</span>
        ))}
      </p>
      <p class="ks-legend-note">
        うち信長自身が出陣した戦 {stats.self} 件。
        {stats.myths} 件には、後世の軍記が加えた脚色について注記がある。
      </p>
      <p class="ks-caution">
        <span class="c-label">兵力について</span>
        合戦の兵力として広く引かれる数字は、その多くが後世の推計や軍記物の記述で、
        同時代の史料までさかのぼれるものは限られている。
        この表では<strong>出典を示せる数字だけ</strong>を載せ、
        それ以外は空欄にしてある。空欄は「不明」ではなく「典拠を確認していない」の意味である。
      </p>
    </div>

    <h2 class="ks-sec-title">上洛以前 — 尾張と美濃（『信長公記』首巻）</h2>
    <div class="ks-table">
      {early.map((b) => (
        <div class="bt">
          <div class="bt-l">
            <span class="bt-year">{b.year}</span>
            <span class="bt-wa">{b.wa}</span>
            <span class="bt-maki">{b.maki}</span>
          </div>
          <div class="bt-r">
            <div class="bt-head">
              <h3 class="bt-name">{b.name}</h3>
              <span class={`rs rs-${RESULT[b.result].rank}`}>{b.result}</span>
            </div>
            <p class="bt-meta">
              <span class="bt-enemy">対 {b.enemy}</span>
              <span class="bt-sep">／</span>
              <span>{b.place}</span>
              {b.self && <span class="bt-self">信長出陣</span>}
            </p>
            <p class="bt-desc">{b.desc}</p>
            {b.forces && (
              <p class="bt-forces">
                {b.forces.map((f) => (
                  <span class="bt-force">
                    <span class="bf-side">{f.side}</span>
                    <span class="bf-num">{f.num}</span>
                    <span class="bf-src">{f.source}</span>
                  </span>
                ))}
              </p>
            )}
            {b.myth && <p class="bt-myth"><span class="c-label">通説</span>{b.myth}</p>}
            {b.episodes && (
              <p class="bt-eps">
                {b.episodes.map((s) => <a href={`/episodes/${s}/`}>{shortTitle(s)} →</a>)}
              </p>
            )}
          </div>
        </div>
      ))}
    </div>

    <h2 class="ks-sec-title">上洛以後 — 畿内と各地（本記十五巻）</h2>
    <div class="ks-table">
      {late.map((b) => (
        <div class="bt">
          <div class="bt-l">
            <span class="bt-year">{b.year}</span>
            <span class="bt-wa">{b.wa}</span>
            <span class="bt-maki">{b.maki}</span>
          </div>
          <div class="bt-r">
            <div class="bt-head">
              <h3 class="bt-name">{b.name}</h3>
              <span class={`rs rs-${RESULT[b.result].rank}`}>{b.result}</span>
            </div>
            <p class="bt-meta">
              <span class="bt-enemy">対 {b.enemy}</span>
              <span class="bt-sep">／</span>
              <span>{b.place}</span>
              {b.self && <span class="bt-self">信長出陣</span>}
            </p>
            <p class="bt-desc">{b.desc}</p>
            {b.forces && (
              <p class="bt-forces">
                {b.forces.map((f) => (
                  <span class="bt-force">
                    <span class="bf-side">{f.side}</span>
                    <span class="bf-num">{f.num}</span>
                    <span class="bf-src">{f.source}</span>
                  </span>
                ))}
              </p>
            )}
            {b.myth && <p class="bt-myth"><span class="c-label">通説</span>{b.myth}</p>}
            {b.episodes && (
              <p class="bt-eps">
                {b.episodes.map((s) => <a href={`/episodes/${s}/`}>{shortTitle(s)} →</a>)}
              </p>
            )}
          </div>
        </div>
      ))}
    </div>

    <p class="ks-foot">
      並べてみると、信長は驚くほど負けている。
      長島では二度退き、木津川口では水軍を失い、北陸では柴田勢が押し返された。
      それでも版図が縮まなかったのは、<strong>負けた戦線を捨てずに抱えたまま、別の戦線で決着をつけ続けた</strong>からである。
      合戦の一覧は、勝敗の記録であると同時に、どこに手が回らなかったかの記録でもある。
    </p>

    <p class="ks-related">
      関連：<a href="/nenpyo/">年表</a>
      <span class="ks-sep">｜</span><a href="/tekitai/">敵対勢力一覧</a>
      <span class="ks-sep">｜</span><a href="/kashin/">家臣一覧</a>
    </p>

    <p class="xref"><span class="xref-label">あわせて</span><a href="/tochu/">途中だったこと — 本能寺が止めたもの →</a></p>


    <p class="ep-back ep-back-btm"><a href="/">← 一覧へ戻る</a></p>
  </article>
</BaseLayout>

<style>
  .kassen { max-width: 58rem; padding-block: 2rem 3rem; }
  .ep-back { margin: 0 0 1rem; }
  .ep-back a { font-size: .84rem; color: var(--sumi-soft); }
  .ep-back-btm { margin-top: 2.4rem; }

  .ks-title { font-size: clamp(1.6rem, 4.5vw, 2.3rem); margin: .2rem 0 1rem; }
  .ks-lead { color: var(--sumi-soft); line-height: 1.9; margin: 0 0 1.8rem; }
  .ks-lead strong { color: var(--shu); }

  .ks-legend {
    border: 1px solid var(--rule); border-left: 3px solid #b8912f;
    background: var(--washi); padding: .9rem 1.1rem; margin-bottom: 2.4rem;
  }
  .ks-legend-row { margin: 0 0 .5rem; display: flex; gap: .45rem; flex-wrap: wrap; }
  .ks-legend-note { margin: 0; font-size: .8rem; color: var(--sumi-soft); line-height: 1.75; }
  .ks-caution {
    margin: .7rem 0 0; padding-top: .6rem; border-top: 1px dotted var(--rule);
    font-size: .79rem; color: var(--sumi-soft); line-height: 1.8;
  }
  .ks-caution strong { color: var(--shu); }
  .c-label {
    font-family: var(--font-mincho); color: var(--shu);
    margin-right: .6em; font-size: .77rem;
  }

  .rs {
    font-family: var(--font-mincho); font-size: .72rem; letter-spacing: .04em;
    padding: .15em .6em; border-radius: 2px; white-space: nowrap; flex-shrink: 0;
    border: 1px solid var(--rs-ink); color: var(--rs-ink); background: var(--rs-bg);
  }
  .rs-5 { --rs-ink:#a11414; --rs-bg:rgba(161,20,20,.07); }
  .rs-3 { --rs-ink:#9a7d3a; --rs-bg:rgba(154,125,58,.06); }
  .rs-2 { --rs-ink:#6f6a63; --rs-bg:rgba(111,106,99,.05); }
  .rs-1 { --rs-ink:#3c6b8a; --rs-bg:rgba(60,107,138,.06); }

  .ks-sec-title {
    font-size: 1.2rem; margin: 0 0 1rem; padding-bottom: .4rem;
    border-bottom: 3px double var(--sumi);
  }
  .ks-table { margin-bottom: 2.6rem; }

  .bt {
    display: grid; grid-template-columns: 5.6rem 1fr; gap: 1rem;
    padding: .9rem 0; border-bottom: 1px dotted var(--rule);
  }
  .bt:last-child { border-bottom: none; }
  .bt-l { display: flex; flex-direction: column; gap: .1rem; padding-top: .1rem; }
  .bt-year { font-family: var(--font-mincho); font-size: 1.15rem; font-weight: 700; }
  .bt-wa { font-size: .7rem; color: var(--sumi-soft); }
  .bt-maki {
    font-family: var(--font-mincho); font-size: .68rem; margin-top: .2rem;
    color: var(--washi); background: var(--sumi);
    padding: .1em .5em; align-self: flex-start; border-radius: 2px;
  }
  .bt-r { min-width: 0; }
  .bt-head { display: flex; align-items: baseline; gap: .7rem; flex-wrap: wrap; }
  .bt-name { font-size: 1.05rem; margin: 0; line-height: 1.45; }
  .bt-meta {
    margin: .2rem 0 .45rem; font-size: .76rem; color: var(--sumi-soft);
    font-family: var(--font-gothic); display: flex; align-items: center; gap: .3rem; flex-wrap: wrap;
  }
  .bt-enemy { color: var(--sumi); }
  .bt-sep { color: var(--rule); }
  .bt-self {
    font-family: var(--font-mincho); font-size: .68rem; color: var(--shu);
    border: 1px solid #c08a80; background: #fbf1ee;
    padding: .05em .45em; border-radius: 2px; margin-left: .3rem;
  }
  .bt-desc { margin: 0; font-size: .88rem; line-height: 1.8; }

  .bt-forces { margin: .5rem 0 0; display: flex; gap: .5rem; flex-wrap: wrap; }
  .bt-force {
    display: inline-flex; align-items: baseline; gap: .45rem;
    background: var(--washi-deep); padding: .3rem .6rem; font-size: .78rem;
  }
  .bf-side { color: var(--sumi-soft); font-size: .72rem; }
  .bf-num { font-family: var(--font-mincho); font-size: .95rem; color: var(--sumi); }
  .bf-src { font-size: .68rem; color: var(--shu); }

  .bt-myth {
    margin: .5rem 0 0; font-size: .79rem; line-height: 1.75; color: var(--sumi-soft);
    background: var(--washi-deep); padding: .45rem .7rem;
  }
  .bt-eps { margin: .45rem 0 0; font-size: .78rem; }
  .bt-eps a { margin-right: .7em; }

  .ks-foot {
    margin: 2.4rem 0 0; padding-top: 1.2rem; border-top: 3px double var(--sumi);
    font-size: .9rem; color: var(--sumi-soft); line-height: 1.95;
  }
  .ks-foot strong { color: var(--shu); }
  .ks-related { margin: 1.2rem 0 0; font-size: .84rem; }
  .ks-sep { color: var(--rule); margin: 0 .5em; }

  @media (max-width: 640px) {
    .bt { grid-template-columns: 1fr; gap: .3rem; }
    .bt-l { flex-direction: row; align-items: baseline; gap: .5rem; }
    .bt-maki { margin-top: 0; }
  }
  .xref {
    margin-top: 2rem; padding: .75rem 1rem;
    border: 1px solid var(--rule); border-left: 3px solid var(--shu);
    background: var(--washi); font-size: .86rem;
  }
  .xref-label {
    font-family: var(--font-mincho); font-size: .78rem; color: var(--shu);
    letter-spacing: .08em; margin-right: .9em;
  }
</style>
