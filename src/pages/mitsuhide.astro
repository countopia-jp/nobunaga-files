---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ornament from '../components/Ornament.astro';
import Seal from '../components/Seal.astro';
import { known, unknown, claims, closing } from '../data/mitsuhide.js';
---
<BaseLayout
  title="明智光秀 — 前半生が、分からない｜ノブナガ・ファイル"
  description="生年も出自も、信長に仕えるまでの経歴も確かめられない。空白を埋めたのは後世の軍記であり、そこから怨恨説が育った。分かっていることと分かっていないことを分けて並べる。"
>
  <article class="wrap mitsuhide">
   <Ornament kind="brush" />
     <p class="ep-back"><a href="/">← 一覧へ戻る</a></p>

    <p class="eyebrow">人物の検証</p>
    <h1 class="mt-title">前半生が、分からない</h1>
    <p class="mt-lead">
      これほど名の知られた人物でありながら、生年も、出自も、
      信長に仕えるまでの経歴も確かめられない。
      <strong>分かっているのは、畿内で頭角を現してからの十数年だけである。</strong>
      分かっていることと、分かっていないことを、分けて並べる。
    </p>

    <div class="mt-cols">
      <section class="col col--known">
        <h2 class="col-title">分かっていること</h2>
        <ul class="col-list">
          {known.map((k) => (
            <li>
              <span class="col-t">{k.t}</span>
              <span class="col-d">{k.d}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="col col--unknown">
        <h2 class="col-title">分かっていないこと</h2>
        <ul class="col-list">
          {unknown.map((u) => (
            <li>
              <span class="col-t">{u.t}</span>
              <span class="col-d">{u.d}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="mt-sec">
      <h2 class="mt-sec-title">検証</h2>
      {claims.map((c) => (
        <div class="claim">
          <div class="claim-head">
            <div class="claim-headtext">
              <h3 class="claim-title">{c.claim}</h3>
              <p class="claim-verdict">{c.verdict}</p>
            </div>
            <div class="claim-seal"><Seal rating={c.rating} size="sm" /></div>
          </div>
          <p class="claim-desc">{c.desc}</p>
          {c.sources && (
            <ul class="claim-sources">
              {c.sources.map((s) => (
                <li>
                  <span class="cs-label">{s.label}</span>
                  <span class="cs-kind">{s.kind}</span>
                  <span class="cs-note">{s.note}</span>
                  {s.quote && (
                    <blockquote class="cs-genbun">
                      <p class="cs-genbun-text">{s.quote}</p>
                      {s.cite && <cite>—{s.cite}</cite>}
                    </blockquote>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </section>

    <section class="mt-closing">
      <h2 class="mt-sec-title">空白から、動機が生まれる</h2>
      {closing.map((p) => <p class="mt-para">{p}</p>)}
    </section>

    <p class="mt-related">
      関連：<a href="/kuromaku/">黒幕説</a>
      <span class="mt-sep">｜</span><a href="/atago/">愛宕百韻</a>
      <span class="mt-sep">｜</span><a href="/episodes/honnoji/">本能寺の変</a>
    </p>

    <p class="ep-back ep-back-btm"><a href="/">← 一覧へ戻る</a></p>
  </article>
</BaseLayout>

<style>
  .mitsuhide { max-width: 52rem; padding-block: 2rem 3rem; }
  .ep-back { margin: 0 0 1rem; }
  .ep-back a { font-size: .84rem; color: var(--sumi-soft); }
  .ep-back-btm { margin-top: 2.4rem; }

  .mt-title { font-size: clamp(1.7rem, 5vw, 2.4rem); margin: .2rem 0 1rem; letter-spacing: .05em; }
  .mt-lead { color: var(--sumi-soft); line-height: 1.95; margin: 0 0 2.4rem; }
  .mt-lead strong { color: var(--shu); }

  .mt-cols {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-bottom: 2.8rem;
  }
  .col { border: 1px solid var(--rule); background: var(--washi); padding: 1rem 1.1rem; }
  .col--known { border-left: 3px solid #b8912f; }
  .col--unknown { border-left: 3px solid var(--shu); background: var(--washi-deep); }
  .col-title {
    font-size: 1.05rem; margin: 0 0 .6rem; padding-bottom: .35rem;
    border-bottom: 1px solid var(--rule); font-family: var(--font-mincho);
  }
  .col-list { list-style: none; margin: 0; padding: 0; }
  .col-list li {
    padding: .5rem 0; border-bottom: 1px dotted var(--rule);
    font-size: .87rem; line-height: 1.85;
  }
  .col-list li:last-child { border-bottom: none; }
  .col-t {
    display: block; font-family: var(--font-mincho); font-weight: 700;
    color: var(--sumi); font-size: .97rem; margin-bottom: .1rem;
  }
  .col-d { color: var(--sumi-soft); }

  .mt-sec { margin-bottom: 2.8rem; }
  .mt-sec-title {
    font-size: 1.25rem; margin: 0 0 .9rem; padding-bottom: .4rem;
    border-bottom: 2px solid var(--sumi); line-height: 1.5;
  }
  .mt-para { margin: 0 0 1.1rem; font-size: .92rem; line-height: 2; }

  .claim {
    border: 1px solid var(--rule); border-left: 3px solid var(--shu);
    background: var(--washi); padding: 1rem 1.1rem; margin-bottom: 1rem;
  }
  .claim-head { display: flex; align-items: flex-start; gap: 1rem; }
  .claim-headtext { flex: 1; min-width: 0; }
  .claim-title { font-size: 1.02rem; margin: 0; line-height: 1.55; }
  .claim-verdict { margin: .2rem 0 0; font-size: .78rem; color: var(--shu); font-family: var(--font-mincho); }
  .claim-seal { flex-shrink: 0; }
  .claim-desc { margin: .7rem 0 0; font-size: .89rem; line-height: 1.85; }

  .mt-closing { margin-top: 3rem; padding-top: 1.4rem; border-top: 3px double var(--sumi); }
  .mt-closing .mt-sec-title { border-bottom-color: var(--shu); }

  .mt-related { margin: 2rem 0 0; font-size: .84rem; }
  .mt-sep { color: var(--rule); margin: 0 .5em; }

  @media (max-width: 780px) {
    .mt-cols { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .claim-head { flex-direction: column; gap: .6rem; }
  }
  .claim-sources {
    list-style: none; margin: .7rem 0 0; padding: .6rem .85rem;
    background: var(--washi-deep); border-left: 2px solid #b8912f;
  }
  .claim-sources li {
    padding: .3rem 0; border-bottom: 1px dotted var(--rule);
    font-size: .82rem; line-height: 1.8;
  }
  .claim-sources li:last-child { border-bottom: none; }
  .cs-label { font-family: var(--font-mincho); font-weight: 700; margin-right: .6em; }
  .cs-kind {
    font-size: .68rem; color: var(--sumi-soft); border: 1px solid var(--rule);
    background: var(--washi); padding: .05em .45em; border-radius: 2px; margin-right: .6em;
  }
  .cs-note { color: var(--sumi-soft); }
  .cs-genbun {
    margin: .5rem 0 .2rem; padding: .6rem .85rem;
    border-left: 2px solid var(--shu); background: #faf7f0;
  }
  .cs-genbun-text {
    margin: 0; font-family: var(--font-mincho); font-size: .93rem;
    line-height: 2.05; letter-spacing: .03em; color: var(--sumi);
  }
  .cs-genbun cite {
    display: block; margin-top: .4rem; font-size: .74rem;
    color: var(--sumi-soft); font-style: normal; line-height: 1.7;
  }
</style>
